public class hw2{
    public static void main(String[] arg){
        InputStreamReader isr = new InputStreamReader(System.in);
        BufferedReader br = new BufferedReader(isr);

        //vars
        int usersec = 0;
        int hours = 0;
        int minutes = 0;

        System.out.print("Enter number of seconds: ");
        try {
            usersec = Integer.parseInt(br.readLine());
        } catch (IOException e) {
            throw new RuntimeException(e);
        }

        //calc how many hours
        hours = usersec / 3600;
        usersec = usersec - hours * 3600;

        //calc minutes
        minutes = usersec / 60;
        usersec = usersec - minutes * 60;

        //seconds is what is left
        System.out.println("Hours " + hours + " Minutes "+  minutes + " Seconds " + usersec);
    }

}
